modules = ["python-3.12", "go-1.24"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["bootdev-cli", "nano"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "run"

[[workflows.workflow]]
name = "run"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run main.py"

[workflows.workflow.metadata]
outputType = "console"
