modules = ["python-3.12", "go-1.24"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["nano"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "build-index"

[[workflows.workflow]]
name = "build-index"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run cli/keyword_search_cli.py build"

[workflows.workflow.metadata]
outputType = "console"
